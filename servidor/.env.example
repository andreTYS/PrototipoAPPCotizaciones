# Copia este archivo como ".env" (cp .env.example .env) y completa los valores.
# El archivo .env NO se sube a GitHub ni se comparte: tiene las claves.

# Dominio real donde ya corre la app web del Cotizador (no uno nuevo: este
# backend va por /api y /uploads bajo el mismo dominio, vía Traefik).
DOMAIN=cotizador.inversionesicr.com
# Clave de la base de datos (una larga y única)
POSTGRES_PASSWORD=cambia-esto-por-una-clave-larga

# URL del ERP real: el login valida el correo y la clave de cada persona
# contra el ERP (nunca se guarda una clave propia acá).
ERP_API_URL=https://erp.inversionesicr.com/api

# Clave para editar cotizaciones, requerimientos y salidas ya registrados (la de siempre es 1234; mejor cámbiala)
CLAVE_EDICION=1234
