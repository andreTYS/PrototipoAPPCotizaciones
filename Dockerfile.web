# Build web/PWA servida como sitio estático — el mismo patrón de despliegue
# (Docker + Traefik) que ya usan el ERP (ICR-LOGISTICA) y la tienda pública
# (ICR-TIENDA) en el VPS de Inversiones ICR.
# stable (no versión fija): image_picker (nuevo en el catálogo) exige un SDK
# de Dart más reciente que el que traía la versión de Flutter fijada antes
# (3.35.5 -> Dart 3.9.2, insuficiente); en vez de perseguir el número exacto
# cada vez que suba una dependencia, se sigue el canal estable.
FROM ghcr.io/cirruslabs/flutter:stable AS build
WORKDIR /app
COPY . .
RUN flutter pub get
# --no-web-resources-cdn: la build sirve su propio CanvasKit en vez de
# depender de Google en cada carga — importante para uso en campo con
# conexión limitada. Ver README.md "Build web / PWA".
RUN flutter build web --release --no-web-resources-cdn

FROM nginx:alpine
COPY --from=build /app/build/web /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
